# Simple square made of 2 triangles with different textures
# Triangle 1 (bottom-right): uses 1.png
# Triangle 2 (top-left): uses 2.png

mtllib square.mtl

# Vertices (2D square in XY plane)
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0

# UV coordinates (0..1 range for each vertex)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normals (all facing +Z towards camera)
vn 0.0 0.0 1.0

# Triangle 1: bottom-right triangle - Material.001 (1.png)
usemtl Material.001
f 1/1/1 2/2/1 4/4/1

# Triangle 2: top-left triangle - Material (2.png)
usemtl Material
f 1/1/1 3/3/1 4/4/1
